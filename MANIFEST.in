include README.md
include LICENSE
include THIRD_PARTY_NOTICES.md
include pyproject.toml
recursive-include docs *.md
recursive-include docs *.png
exclude docs/HANDOFF.md
prune engagements
prune var
prune models
prune data/advisories
prune build
prune .venv
prune validation
prune astrolabe.egg-info
global-exclude *.egg-info
global-exclude *.egg-info/*
